#!/usr/bin/env bash
set -o pipefail

DOWNLOADS_DIR="$HOME/Downloads"
DRY_RUN=false

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run|-n)
      DRY_RUN=true
      shift
      ;;
    -h|--help)
      echo "Usage: sort-downloads [--dry-run|-n] [DIRECTORY]"
      exit 0
      ;;
    *)
      DOWNLOADS_DIR="$1"
      shift
      ;;
  esac
done

if [[ "$DRY_RUN" == true ]]; then
  echo -e "\033[1;33m[DRY RUN MODE]\033[0m Simulating moves (no files will be touched):"
fi

if [[ ! -d "$DOWNLOADS_DIR" ]]; then
  echo "Error: Directory '$DOWNLOADS_DIR' does not exist."
  exit 1
fi

cd "$DOWNLOADS_DIR"

move_files() {
  local target_folder="$1"
  shift
  local count=0

  for ext in "$@"; do
    shopt -s nullglob nocaseglob
    for file in *."$ext"; do
      # Only process regular files (never move folders or subdirectories)
      if [[ -f "$file" ]]; then
        # Skip ongoing browser downloads
        if [[ "$file" =~ \.(crdownload|part|tmp)$ ]]; then
          continue
        fi

        if [[ "$DRY_RUN" == true ]]; then
          echo -e "  [would move] \033[36m$file\033[0m -> \033[34m$target_folder/\033[0m"
        else
          mkdir -p "$target_folder"
          # -n prevents overwriting existing files
          mv -n "$file" "$target_folder/"
        fi
        count=$((count + 1))
      fi
    done
    shopt -u nullglob nocaseglob
  done

  if [[ $count -gt 0 ]]; then
    if [[ "$DRY_RUN" == true ]]; then
      echo -e "\033[1;33m→\033[0m Would move \033[1m$count\033[0m file(s) into \033[1;34m$target_folder/\033[0m\n"
    else
      echo -e "\033[1;32m✓\033[0m Moved \033[1m$count\033[0m file(s) into \033[1;34m$target_folder/\033[0m\n"
    fi
  fi
}

echo "Scanning: $DOWNLOADS_DIR"
echo "----------------------------------------------------"

# Categories tailored for your files:
move_files "Images"       png jpg jpeg gif webp svg heic avif ico bmp tif tiff
move_files "Documents"    pdf docx doc xlsx pptx txt md epub csv rtf odt
move_files "Media"        mp4 mkv mp3 wav flac mov avi webm m4a aac
move_files "Archives"     zip tar gz bz2 xz 7z rar tgz
move_files "Installers"   iso AppImage deb rpm apk exe msi flatpak
move_files "Engineering"  dwg dxf std
move_files "Code"         py rs go js ts sh bash nix c cpp h json yaml yml toml html css vbs

echo "----------------------------------------------------"
echo "Done!"
